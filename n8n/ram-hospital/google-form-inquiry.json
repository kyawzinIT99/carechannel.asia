{
  "name": "Ram Hospital Google Form to CRM",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ram-hospital-google-form",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wh-gform",
      "name": "Google Form webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "ram-hospital-google-form"
    },
    {
      "parameters": {
        "path": "ram-hospital-visit",
        "formTitle": "Chiangmai Ram Hospital visit request",
        "formDescription": "Same four details as the website request. A coordinator follows up. This is not emergency care.",
        "formFields": {
          "values": [
            { "fieldLabel": "Name", "fieldType": "text", "requiredField": true, "placeholder": "Full name" },
            { "fieldLabel": "Email", "fieldType": "email", "requiredField": true, "placeholder": "name@email.com" },
            { "fieldLabel": "Phone", "fieldType": "text", "requiredField": true, "placeholder": "+95 …" },
            { "fieldLabel": "Nationality", "fieldType": "text", "requiredField": true, "placeholder": "Myanmar" }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "buttonLabel": "Send request",
          "appendAttribution": false
        }
      },
      "id": "form-simple",
      "name": "Simple visit form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [0, 220],
      "webhookId": "ram-hospital-visit"
    },
    {
      "parameters": {
        "jsCode": "const raw = items[0].json;\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nconst nv = body.namedValues && typeof body.namedValues === 'object' ? body.namedValues : {};\nfunction pick(obj, keys) {\n  for (const key of keys) {\n    const val = obj[key];\n    if (Array.isArray(val) && val[0]) return String(val[0]).trim();\n    if (val != null && String(val).trim()) return String(val).trim();\n  }\n  return '';\n}\nconst keysName = ['fullName', 'Name', 'name', 'Full name'];\nconst keysEmail = ['email', 'Email'];\nconst keysPhone = ['phone', 'Phone', 'mobile', 'tel'];\nconst keysNat = ['country', 'Country', 'nationality', 'Nationality'];\nconst fullName = pick(body, keysName) || pick(nv, keysName);\nconst email = pick(body, keysEmail) || pick(nv, keysEmail);\nconst phone = pick(body, keysPhone) || pick(nv, keysPhone);\nconst country = pick(body, keysNat) || pick(nv, keysNat) || 'Myanmar';\nreturn [{ json: { fullName, email, phone, country, locale: 'en', message: 'Visit request (name, email, phone, nationality)' } }];"
      },
      "id": "map-fields",
      "name": "Map name email phone nationality",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [280, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://carechannel.onrender.com/api/v1/internal/n8n/inquiries",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Ram-Hospital-Secret",
              "value": "={{$env.RAM_HOSPITAL_WEBHOOK_SECRET}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json)}}",
        "options": {}
      },
      "id": "post-crm",
      "name": "Create inquiry in CareChannel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [540, 220]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "1eUxxpTDInD65CL8kNPCi92YEmxyP_ipC1uYnA15oMPw",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "1999607699",
          "mode": "id"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{$now.toISO()}}",
            "Name": "={{$('Map name email phone nationality').item.json.fullName}}",
            "Email": "={{$('Map name email phone nationality').item.json.email}}",
            "Phone": "={{$('Map name email phone nationality').item.json.phone}}",
            "Nationality": "={{$('Map name email phone nationality').item.json.country}}"
          }
        },
        "options": {}
      },
      "id": "append-sheet",
      "name": "Log to Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [780, 220],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "tNzD3SlIUiRK6beo",
          "name": "Google Sheets account"
        }
      }
    }
  ],
  "connections": {
    "Google Form webhook": {
      "main": [[{ "node": "Map name email phone nationality", "type": "main", "index": 0 }]]
    },
    "Simple visit form": {
      "main": [[{ "node": "Map name email phone nationality", "type": "main", "index": 0 }]]
    },
    "Map name email phone nationality": {
      "main": [[
        { "node": "Create inquiry in CareChannel", "type": "main", "index": 0 },
        { "node": "Log to Google Sheet", "type": "main", "index": 0 }
      ]]
    }
