{
  "name": "Ram Hospital Telegram Ingress",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "tg-in",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "credentials": {
        "telegramApi": {
          "id": "RAM_HOSPITAL_TELEGRAM",
          "name": "RAM_HOSPITAL_TELEGRAM"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.first().json.message || {};\nconst text = String(msg.text || '').trim();\nconst chatId = msg.chat?.id;\nconst locale = /[\\u1000-\\u109F]/.test(text) ? 'my' : 'en';\nreturn [{ json: { chatId, locale, text } }];"
      },
      "id": "parse",
      "name": "Detect EN or MY",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.RAM_HOSPITAL_APP_URL}}/api/v1/internal/n8n/telegram",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Ram-Hospital-Secret", "value": "={{$env.RAM_HOSPITAL_WEBHOOK_SECRET}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({ locale: $json.locale, text: $json.text })}}",
        "options": {}
      },
      "id": "app",
      "name": "Approved template from app",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "chatId": "={{$('Detect EN or MY').item.json.chatId}}",
        "text": "={{$json.text}}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "reply",
      "name": "Reply Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [660, 0],
      "credentials": {
        "telegramApi": {
          "id": "RAM_HOSPITAL_TELEGRAM",
          "name": "RAM_HOSPITAL_TELEGRAM"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [[{ "node": "Detect EN or MY", "type": "main", "index": 0 }]]
    },
    "Detect EN or MY": {
      "main": [[{ "node": "Approved template from app", "type": "main", "index": 0 }]]
    },
    "Approved template from app": {
      "main": [[{ "node": "Reply Telegram", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
