{
  "name": "Ram Hospital Inquiry Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ram-hospital-inquiry",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-inquiry",
      "name": "Ram Inquiry Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "ram-hospital-inquiry"
    },
    {
      "parameters": {
        "jsCode": "const raw = items[0].json;\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nconst headers = raw.headers || {};\nconst secret = String(headers['x-ram-hospital-secret'] || headers['X-Ram-Hospital-Secret'] || '');\nconst expected = String(body.webhookSecret || '');\nif (expected && secret && secret !== expected) { throw new Error('Ram Hospital webhook secret was not accepted'); }\nconst guestEmail = String(body.guestEmail || '').trim();\nconst staffEmail = String(body.staffEmail || body.alertEmail || body.toEmail || 'itsolutions.mm@gmail.com').trim();\nconst chatId = String(body.telegramChatId || '').trim();\nconst telegramText = String(body.telegramText || body.text || '').trim();\nconst guestHtml = String(body.guestHtml || '').trim();\nconst staffHtml = String(body.staffHtml || body.html || '').trim();\nconst guestSubject = String(body.guestSubject || 'Chiangmai Ram partner channel — your visit request');\nconst staffSubject = String(body.staffSubject || body.subject || 'Ram Hospital inquiry');\nreturn [{ json: { ...body, guestEmail, staffEmail, toEmail: staffEmail, telegramChatId: chatId, telegramText, text: telegramText, guestHtml, staffHtml, html: staffHtml || guestHtml, guestSubject, subject: staffSubject } }];"
      },
      "id": "check-secret",
      "name": "Check Ram secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.guestEmail}}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "if-guest",
      "name": "Has guest email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, -180]
    },
    {
      "parameters": {
        "sendTo": "={{$json.guestEmail}}",
        "subject": "={{$json.guestSubject}}",
        "emailType": "html",
        "message": "={{$json.guestHtml}}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "gmail-guest",
      "name": "Patient email",
